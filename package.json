{
  "name": "@eslaykey/dsh-breeze-tts",
  "version": "1.0.2",
  "description": "Breeze Blue text-to-speech for DeepSeek Harness: agent tools, reply playback, voice design and a settings page.",
  "author": "eslaykey",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "text-to-speech",
    "breeze",
    "voice"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EslayKey/dsh-breeze-tts.git"
  },
  "homepage": "https://github.com/EslayKey/dsh-breeze-tts#readme",
  "bugs": {
    "url": "https://github.com/EslayKey/dsh-breeze-tts/issues"
  }
}
